# Ignore everything by default
*
# Allow Git to traverse directories
!*/

# Explicitly ignore unwanted directories so their contents are never tracked
.venv/
venv/
__pycache__/
.idea/
.vscode/
PDFs tests/

# Un-ignore the specific file types and files we want to track
!*.py
!requirements.txt
!Dockerfile
!.dockerignore
!.gitignore
!מסמך אפיון.txt
!GEMINI.md
