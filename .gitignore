# Ignore everything by default
*
# Allow Git to traverse directories
!*/

# Explicitly ignore unwanted directories and internal files so they are never tracked
.venv/
venv/
__pycache__/
.idea/
.vscode/
PDFs tests/
מסמך אפיון.txt
GEMINI.md

# Un-ignore the specific file types and files we want to track
!*.py
!requirements.txt
!Dockerfile
!.dockerignore
!.gitignore
!README.md
